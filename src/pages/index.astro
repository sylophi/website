---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ToolList from '../components/ToolList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { apps, appTools, devApps, tools, musicApps, musicTools, gameTools } from '../content/projects';
---

<Base>
  <div class="mx-auto flex min-h-screen w-full max-w-2xl flex-col px-6 py-10 md:py-16">
    <header class="mb-16 flex items-center justify-between">
      <h1 class="leading-tight">
        <span class="block text-[18px] font-medium tracking-tight text-foreground">harper</span>
        <span class="mt-0.5 block text-[11px] tracking-wide text-muted-foreground lowercase">
          sylophi
        </span>
      </h1>
      <SocialLinks />
    </header>

    <main class="flex flex-col gap-14">
      <section aria-labelledby="apps-label">
        <h2
          id="apps-label"
          class="mb-4 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
        >
          Apps
        </h2>
        <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          {apps.map((app) => <ProjectCard project={app} />)}
        </div>
        <ToolList tools={appTools} />
      </section>

      <section aria-labelledby="game-dev-label">
        <h2
          id="game-dev-label"
          class="mb-4 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
        >
          Game development
        </h2>
        <ToolList tools={gameTools} />
      </section>

      <section aria-labelledby="dev-tools-label">
        <h2
          id="dev-tools-label"
          class="mb-4 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
        >
          Dev tools
        </h2>
        {
          devApps.length > 0 && (
            <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
              {devApps.map((app) => (
                <ProjectCard project={app} />
              ))}
            </div>
          )
        }
        <ToolList tools={tools} />
      </section>

      <section aria-labelledby="music-tools-label">
        <h2
          id="music-tools-label"
          class="mb-4 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
        >
          Music tools
        </h2>
        {
          musicApps.length > 0 && (
            <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
              {musicApps.map((app) => (
                <ProjectCard project={app} />
              ))}
            </div>
          )
        }
        <ToolList tools={musicTools} />
      </section>
    </main>
  </div>
</Base>
