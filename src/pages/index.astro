---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ToolGrid from '../components/ToolGrid.astro';
import ToolList from '../components/ToolList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import {
  webApps,
  webAppTools,
  devApps,
  tools,
  dittofleet,
  musicAudioApps,
  musicAudioTools,
  gameTools,
} from '../content/projects';
---

<Base>
  <div class="mx-auto flex min-h-screen w-full max-w-2xl flex-col px-6 py-10 md:py-16">
    <header class="mb-16 flex items-center justify-between">
      <h1 class="leading-tight">
        <span class="block text-[18px] font-medium tracking-tight text-foreground">harper</span>
        <span class="mt-0.5 block text-[11px] tracking-wide text-muted-foreground lowercase">
          sylophi
        </span>
      </h1>
      <SocialLinks />
    </header>

    <main class="flex flex-col gap-14">
      <section aria-labelledby="dev-tools-label">
        <h2
          id="dev-tools-label"
          class="mb-4 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
        >
          Dev tools
        </h2>
        {
          devApps.length > 0 && (
            <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
              {devApps.map((app) => (
                <ProjectCard project={app} />
              ))}
            </div>
          )
        }
        <ToolList tools={tools} />
      </section>

      <section aria-labelledby="dittofleet-label">
        <div class="mb-6 flex items-center justify-between gap-4">
          <div>
            <h2
              id="dittofleet-label"
              class="mb-1.5 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
            >
              dittofleet
            </h2>
            <p class="text-[13px] text-muted-foreground">{dittofleet.description}</p>
          </div>
          <a
            href={dittofleet.url}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 text-[11px] text-muted-foreground transition-colors hover:text-foreground"
          >
            github →
          </a>
        </div>
        <div class="flex flex-col gap-6">
          {
            dittofleet.groups.map((group) => (
              <div>
                <h3 class="mb-3 text-[12px] text-muted-foreground">{group.name}</h3>
                <ToolGrid tools={group.tools} />
              </div>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="music-audio-label">
        <h2
          id="music-audio-label"
          class="mb-4 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
        >
          Music &amp; audio
        </h2>
        {
          musicAudioApps.length > 0 && (
            <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
              {musicAudioApps.map((app) => (
                <ProjectCard project={app} />
              ))}
            </div>
          )
        }
        <ToolList tools={musicAudioTools} />
      </section>

      <section aria-labelledby="game-dev-label">
        <h2
          id="game-dev-label"
          class="mb-4 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
        >
          Game development
        </h2>
        <ToolList tools={gameTools} />
      </section>

      <section aria-labelledby="web-apps-label">
        <h2
          id="web-apps-label"
          class="mb-4 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase"
        >
          Web apps
        </h2>
        <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          {webApps.map((app) => <ProjectCard project={app} />)}
        </div>
        <ToolList tools={webAppTools} />
      </section>
    </main>
  </div>
</Base>
