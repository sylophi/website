---
import { Image } from 'astro:assets';
import type { Project } from '../content/projects';
import { statusLabel } from '../content/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isLinked = Boolean(project.url);
const NameTag = isLinked ? 'a' : 'span';
---

<article
  class:list={[
    'group relative block overflow-hidden rounded-[var(--radius)] border bg-muted',
    'transition-colors duration-150',
    isLinked ? 'hover:border-muted-foreground/40' : '',
  ]}
>
  <div class="relative aspect-[3/2] overflow-hidden border-b bg-background">
    <Image
      src={project.screenshot}
      alt={project.screenshotAlt}
      widths={[640, 1280, 1600]}
      sizes="(min-width: 768px) 320px, 100vw"
      loading="lazy"
      decoding="async"
      class:list={[
        'h-full w-full object-cover',
        'transition-transform duration-[400ms] ease-out',
        isLinked ? 'group-hover:scale-[1.015]' : '',
      ]}
    />
  </div>

  <div class="flex flex-col gap-1 px-4 py-3.5">
    <div class="flex items-center gap-2">
      <NameTag
        {...isLinked
          ? {
              href: project.url,
              target: '_blank',
              rel: 'noopener noreferrer',
            }
          : {}}
        class:list={[
          'text-[15px] font-medium tracking-tight text-foreground',
          // Stretch the link over the whole card so it stays clickable everywhere
          isLinked ? 'after:absolute after:inset-0' : '',
        ]}
      >
        {project.name}
      </NameTag>
      {
        project.status && (
          <span class="rounded-full border bg-background px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
            {statusLabel(project.status)}
          </span>
        )
      }
      {
        project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 ml-auto text-[11px] text-muted-foreground transition-colors hover:text-foreground"
          >
            github →
          </a>
        )
      }
    </div>
    <p class="text-[13px] leading-relaxed text-muted-foreground">
      {project.description}
    </p>
  </div>
</article>
