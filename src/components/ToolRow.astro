---
import type { Tool } from '../content/projects';
import { statusLabel } from '../content/projects';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const isLinked = Boolean(tool.repoUrl);
const Tag = isLinked ? 'a' : 'div';
---

<Tag
  {...isLinked
    ? {
        href: tool.repoUrl,
        target: '_blank',
        rel: 'noopener noreferrer',
      }
    : {}}
  class="group flex flex-col gap-1 border-b py-3 transition-colors duration-150 last:border-b-0 sm:flex-row sm:items-baseline sm:gap-4"
>
  <span class="flex items-center gap-2 sm:shrink-0">
    <span class="text-[13px] font-medium text-foreground">
      {tool.name}
    </span>
    {
      tool.status && (
        <span class="rounded-full border bg-background px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
          {statusLabel(tool.status)}
        </span>
      )
    }
  </span>
  <span
    class:list={[
      'flex-1 text-[13px] text-muted-foreground transition-colors',
      isLinked ? 'group-hover:text-foreground' : '',
    ]}
  >
    {tool.description}
  </span>
  <span
    class:list={[
      'text-[11px] text-muted-foreground transition-colors sm:shrink-0',
      isLinked ? 'group-hover:text-foreground' : '',
    ]}
  >
    {isLinked && 'github →'}
  </span>
</Tag>
